# ─────────────────────────────────────────────────────────────────────────────
# ANTIM SAHARA — environment template
# Copy this file to `.env.local` and fill in. The app runs fully WITHOUT any of
# these (DEMO_MODE), so add them only when you want live AI / cloud sync.
# Keep this file out of git. NEVER put secrets in NEXT_PUBLIC_* (those ship to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# Demo mode: when true, agents return cached/deterministic output (no live Gemini calls).
# Set to false ONLY after GEMINI_API_KEY is set and you want live AI.
NEXT_PUBLIC_DEMO_MODE=true

# ── Gemini (server-side only) ───────────────────────────────────────────────
# Get free keys at https://aistudio.google.com/apikey
# MULTIPLE keys are supported with automatic round-robin + failover on rate limits.
# Easiest: comma-separate several keys (the more you add, the higher your headroom):
GEMINI_API_KEYS=
# Or a single key:
GEMINI_API_KEY=
# (You can also use numbered GEMINI_API_KEY_2, GEMINI_API_KEY_3, … up to _10.)
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Firebase (optional — enables cloud auth + Firestore sync) ────────────────
# From Firebase console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK (server-side) — paste the WHOLE service-account JSON on one line.
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# ── Bhashini (optional — authentic Indic ASR/TTS/translation) ────────────────
# Register at https://bhashini.gov.in (ULCA). Until set, voice falls back to the
# browser's speech engine + Gemini translation.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
